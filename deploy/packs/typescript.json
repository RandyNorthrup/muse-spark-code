{
  "name": "typescript",
  "version": "1.0.0",
  "description": "Node 24 and 22 with the TypeScript gate set: prettier, eslint with typescript-eslint, tsc, knip, dpdm (not madge: madge's peer range rejects TypeScript 6), npm audit, semgrep, vitest, stylelint and htmlhint. TypeScript stays on 6.0.x while typescript-eslint's peer range excludes 7.",
  "license": "Apache-2.0 AND ISC AND LGPL-2.1-or-later AND MIT AND PSF-2.0",
  "languages": ["typescript"],
  "requires": ["python"],
  "checks": [
    {
      "name": "eslint",
      "command": ["eslint", "--max-warnings=0"]
    },
    {
      "name": "tsc",
      "command": ["tsc", "--noEmit"]
    },
    {
      "name": "prettier",
      "command": ["prettier", "--check", "."]
    },
    {
      "name": "knip",
      "command": ["knip"]
    },
    {
      "name": "dpdm",
      "command": [
        "dpdm",
        "--no-warning",
        "--no-tree",
        "--exit-code",
        "circular:1",
        "-T",
        "src/**/*.ts"
      ]
    },
    {
      "name": "semgrep",
      "command": ["semgrep", "scan", "--error"]
    },
    {
      "name": "vitest",
      "command": ["vitest", "run"]
    },
    {
      "name": "npm-audit",
      "command": ["npm", "audit"]
    },
    {
      "name": "stylelint",
      "command": ["stylelint", "--max-warnings=0"]
    },
    {
      "name": "htmlhint",
      "command": ["htmlhint", "**/*.html"]
    }
  ],
  "constraints": [
    {
      "package": "typescript",
      "range": ">=6.0.0 <6.1.0",
      "reason": "typescript-eslint 8's peer range excludes TypeScript 7; a newer TypeScript would silently disable every type-aware rule"
    }
  ],
  "clickThrough": false,
  "checkedAt": "2026-10-22",
  "upstream": [
    {
      "name": "uv",
      "version": "0.13.5",
