# Environment variables read by tooling. The extension itself stores the user's
# Meta Model API key in VS Code SecretStorage, never in a file.
#
# Optional: used only by `muse serve` when the extension is configured to
# inject a key into the Muse Code CLI child process (M2). Leave empty here;
# real values belong in your shell or SecretStorage, never in this repo.
META_API_KEY=
