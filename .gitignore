# build output
dist/
*.vsix
# OS1 image composer outputs (os/build.py writes images, manifests and
# qualification clones here; receipts land in docs/certification/).
/out/
# The macOS dictation helper, compiled by CI's macOS job (native/darwin/build.sh)
native/darwin/muse-dictate
native/darwin/muse-dictate-*
native/darwin/muse-vault-peer*
native/darwin/muse-local-judge-peer
native/darwin/muse-local-judge-peer-*

# dependencies
node_modules/

# test artifacts
coverage/
.vscode-test/

# secrets and local environment — never commit
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Temporary files
temp/
# Headless-Chrome screenshots from scripts/harness-shots.mjs
harness-shots/
# The harness's pseudo-locale table, written by scripts/pseudo-l10n.mjs
test/harness/l10n/
# Claude Code session settings (permission rules), written by the tool
.claude/

# Linux created-path helpers, compiled from the reviewed native source.
native/linux/
