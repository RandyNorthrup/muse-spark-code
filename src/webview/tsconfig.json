{
  // Webview project: browser runtime, React 19 automatic JSX runtime.
  // Shares src/shared/** with the host project; must never import from
  // src/host or src/core (those pull in Node and `vscode`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vscode-webview"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../shared/**/*.ts"],
  // The Node boundary roots export Node-only members (file-tool execution,
  // the SSH wire format); the browser never imports them, so they stay out
  // of this program.
  "exclude": ["../shared/modelApiBoundariesEntry.ts", "../shared/vaultBoundariesEntry.ts"]
}
