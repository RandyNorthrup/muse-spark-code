                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[\\w-][\\w.-]*$"
                      },
                      "kind": {
                        "type": "string",
                        "const": "tool"
