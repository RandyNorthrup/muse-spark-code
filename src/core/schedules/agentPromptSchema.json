                              "hour": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 23
                              },
                              "minute": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 59
                              }
                            },
                            "required": ["hour", "minute"],
                            "additionalProperties": false
                          }
                        },
                        "anchorDate": {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        }
                      },
                      "required": ["kind", "everyDays", "times", "anchorDate"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "weekdays"
                        },
                        "times": {
                          "minItems": 1,
                          "maxItems": 24,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "hour": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 23
                              },
                              "minute": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 59
                              }
                            },
                            "required": ["hour", "minute"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["kind", "times"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "weekly"
                        },
                        "days": {
                          "minItems": 1,
                          "maxItems": 7,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "weekday": {
                                "type": "integer",
                                "minimum": 0,
