                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "required": ["id", "kind", "name"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[\\w-][\\w.-]*$"
                      },
                      "kind": {
                        "type": "string",
                        "const": "path"
                      },
                      "glob": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "access": {
                        "type": "string",
                        "enum": ["read", "edit"]
                      }
                    },
                    "required": ["id", "kind", "glob", "access"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "destinationIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[\\w-][\\w.-]*$"
              }
            },
            "paidCapUsd": {
              "type": "number",
              "minimum": 0
            }
