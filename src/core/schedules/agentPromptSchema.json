                    "conditions": {
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "enum": [
                              "repository",
                              "branch",
                              "author",
                              "label",
                              "milestoneId",
                              "status"
