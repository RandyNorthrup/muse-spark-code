                                      "minimum": 0,
                                      "maximum": 23
                                    },
                                    "minute": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 59
                                    }
                                  },
                                  "required": ["hour", "minute"],
                                  "additionalProperties": false
