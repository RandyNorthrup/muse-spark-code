                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "once"
                    },
                    "atMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["kind", "atMs"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "interval"
