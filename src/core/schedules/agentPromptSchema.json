                      "type": "string",
                      "enum": [
                        "pullRequestOpened",
                        "pullRequestClosed",
                        "pullRequestMerged",
                        "reviewRequested",
                        "ciFinished",
                        "releasePublished",
                        "issueLabelled",
                        "issueOpened",
                        "issueReplied",
                        "branchUpdated",
                        "tagCreated",
                        "milestoneStatusChanged",
                        "milestoneCertified",
                        "turnFinished",
                        "laneFinished",
                        "taskFinished",
                        "teamFinished",
                        "questionAnswered",
                        "usageThresholdCrossed",
                        "resourceLevelChanged",
                        "filesChanged",
                        "versionPublished",
                        "manual"
                      ]
