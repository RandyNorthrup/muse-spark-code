        },
        "catchUp": {
          "type": "string",
          "enum": ["runOnce", "skip"]
        },
        "mode": {
          "type": "string",
          "enum": ["manual", "plan", "acceptEdits", "auto"]
        },
        "grant": {
          "type": "object",
          "properties": {
            "rules": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[\\w-][\\w.-]*$"
                      },
                      "kind": {
                        "type": "string",
