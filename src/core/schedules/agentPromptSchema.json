                    "everyMs": {
                      "type": "integer",
                      "minimum": 60000,
                      "maximum": 9007199254740991
                    },
                    "anchorMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["kind", "everyMs", "anchorMs"],
                  "additionalProperties": false
