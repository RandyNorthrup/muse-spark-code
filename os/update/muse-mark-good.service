# Trial-boot mark-good unit (OS2, M110). Runs once per boot after the node
# service, and marks the trial slot good only when /readyz passes inside
# the bounded timeout owned by /usr/lib/muse-update/mark-good
# (MUSE_MARK_GOOD_TIMEOUT_SEC, default 300). On failure it marks the slot
# bad and reboots into the stable slot. Enabled on the image by
# OS2-OS1-RECIPE; it is not started anywhere else.
#
# The script handles both targets: with autoboot.txt present it drives the
# Pi tryboot backend, otherwise it mirrors the EFI backend decision through
# `rauc status mark-good/mark-bad`. No per-target unit is needed.

[Unit]
Description=Muse Node trial-boot mark-good (OS2)
After=muse-node.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/muse-update/mark-good
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
