#!/bin/sh
# Trial-boot mark-good for Muse Node OS updates (OS2, M110).
#
# It marks the trial slot good only after the node's /readyz passes inside
# MUSE_MARK_GOOD_TIMEOUT_SEC (default 300, bounded). A probe error, a probe
# timeout, or a boot that fell back to the stable slot marks the trial slot
# bad and falls back; a trial slot is never marked good on a probe error.
#
# Two targets, one script:
#  - Pi (MUSE_PI_BOOT_DIR/autoboot.txt exists): the trial target comes from
#    `pi-tryboot-backend get-trial` and the running slot from `get-current`.
#    A trial that fell back (current != trial) is marked bad without a
#    reboot, because the machine already runs the stable slot. A trial that
#    is running here (current == trial) is probed: pass marks good (and the
#    backend promotes the stable selection), failure marks bad and reboots
#    into the untouched stable slot.
#  - UEFI (no autoboot.txt): the EFI backend owns boot ordering, so a
#    passing probe marks good and a failing probe marks bad and reboots.
#    A normal boot with no trial in progress marks the running slot good,
#    which is a no-op confirmation.
#
# RAUC bookkeeping (`rauc status mark-good/mark-bad`) mirrors the backend
# decision so `rauc status` agrees with the boot selection. The backend is
# authoritative for booting: if RAUC is missing or refuses, this script
# fails closed without marking anything good.
#
# Environment: MUSE_TRYBOOT_BACKEND (default
# /usr/lib/muse-update/pi-tryboot-backend), MUSE_PI_BOOT_DIR (default
# /boot/firmware), MUSE_RAUC_CMD (default rauc), MUSE_READYZ_PROBE (a probe
# command whose exit 0 passes; default curls the port named by
# MUSE_NODE_PORT_FILE, default /run/muse-node/port, with --max-time 5),
# MUSE_MARK_GOOD_TIMEOUT_SEC (default 300), MUSE_MARK_GOOD_INTERVAL_SEC
# (default 5), MUSE_REBOOT_CMD (default reboot). Tests inject the probe,
# rauc and reboot as fakes; production never runs a fake.

set -u

BACKEND="${MUSE_TRYBOOT_BACKEND:-/usr/lib/muse-update/pi-tryboot-backend}"
RAUC="${MUSE_RAUC_CMD:-rauc}"
REBOOT="${MUSE_REBOOT_CMD:-reboot}"
TIMEOUT="${MUSE_MARK_GOOD_TIMEOUT_SEC:-300}"
INTERVAL="${MUSE_MARK_GOOD_INTERVAL_SEC:-5}"

log() {
    echo "muse-mark-good: $1" >&2
}

fail() {
    log "FAIL $1"
    exit 1
}

probe_once() {
    if [ -n "${MUSE_READYZ_PROBE:-}" ]; then
        $MUSE_READYZ_PROBE >/dev/null 2>&1
        return
    fi
    if [ ! -f "${MUSE_NODE_PORT_FILE:-/run/muse-node/port}" ]; then
        return 1
    fi
    port=$(cat "${MUSE_NODE_PORT_FILE:-/run/muse-node/port}" 2>/dev/null) || return 1
    case "$port" in
        '' | *[^0-9]*) return 1 ;;
    esac
    command -v curl >/dev/null 2>&1 || return 1
    curl -fsS --max-time 5 "http://127.0.0.1:$port/readyz" >/dev/null 2>&1
}

probe_until_ready() {
    start=$(date +%s) || fail "no-clock"
    while :; do
        if probe_once; then
            return 0
        fi
        now=$(date +%s) || fail "no-clock"
        if [ "$((now - start))" -ge "$TIMEOUT" ]; then
            return 1
        fi
        sleep "$INTERVAL" || fail "no-sleep"
    done
}

rauc_mark() {
    if ! command -v "$RAUC" >/dev/null 2>&1 && [ ! -x "$RAUC" ]; then
        log "no-rauc cmd=$RAUC"
        return 1
    fi
    if "$RAUC" status "mark-$1" >/dev/null 2>&1; then
        return 0
    fi
    log "rauc-refused mark=$1"
    return 1
}

mark_bad_and_fall_back() {
    # $1 is "pi" or "efi"; $2 is the trial slot on Pi (unused on EFI).
    if [ "$1" = "pi" ]; then
        "$BACKEND" set-state "$2" bad >/dev/null 2>&1 || fail "backend-bad slot=$2"
    fi
    rauc_mark bad || log "continuing-to-reboot-without-rauc-mark"
    log "rebooting-to-stable"
    $REBOOT >/dev/null 2>&1 || fail "no-reboot"
    fail "reboot-returned"
}

if [ -f "${MUSE_PI_BOOT_DIR:-/boot/firmware}/autoboot.txt" ]; then
    trial=$("$BACKEND" get-trial 2>/dev/null) || fail "backend-trial"
    case "$trial" in
        none) exit 0 ;;
        A | B) ;;
        *) fail "backend-trial=$trial" ;;
    esac
    current=$("$BACKEND" get-current 2>/dev/null) || fail "backend-current"
    case "$current" in
        A | B) ;;
        *) fail "backend-current=$current" ;;
    esac
    if [ "$current" != "$trial" ]; then
        # The trial fell back by itself (crash or reset): record bad.
        log "fell-back trial=$trial current=$current"
        "$BACKEND" set-state "$trial" bad >/dev/null 2>&1 || fail "backend-bad slot=$trial"
        rauc_mark bad || log "continuing-without-rauc-mark"
        fail "trial-failed"
    fi
    if probe_until_ready; then
        "$BACKEND" set-state "$trial" good >/dev/null 2>&1 || fail "backend-good slot=$trial"
        rauc_mark good || fail "rauc-good"
        log "marked-good trial=$trial"
        exit 0
    fi
    log "probe-failed trial=$trial"
    mark_bad_and_fall_back pi "$trial"
else
    if probe_until_ready; then
        rauc_mark good || fail "rauc-good"
        log "marked-good efi"
        exit 0
    fi
    log "probe-failed efi"
    mark_bad_and_fall_back efi ""
fi
