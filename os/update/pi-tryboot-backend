#!/bin/sh
# RAUC custom bootloader backend for Raspberry Pi A/B tryboot (OS2, M110).
#
# RAUC 1.13 drives this script as its `bootloader=custom` backend
# (bootchooser.c `boot_custom_*`): the only calls RAUC core ever makes are
#   get-current, get-primary, set-primary <A|B>,
#   get-state <A|B>, set-state <A|B> <good|bad>.
# `get-trial` is this lane's extension for the mark-good path; RAUC ignores it.
# In particular RAUC never sends `set-state <slot> active`: that verb belonged
# to the previous design and is refused here (BAD_STATE).
#
# One-shot trial semantics (the lead's design; the full RAUC call, backend
# action and autoboot.txt state table is in
# docs/certification/m110-os2-image-update.md):
#  - set-primary X ARMS a one-shot tryboot trial of X. The stable [all]
#    selection is never changed here. (RAUC install.c calls this after writing
#    the inactive slot when activation is on; mark.c `mark-active` lands here
#    too. Arming the already-stable slot clears any trial instead.)
#  - set-state X good, called by mark-good only after /readyz passes while
#    running X, PROMOTES X to stable. Any other good marking only records, so
#    an install-time marking can never promote an untried slot.
#  - set-state X bad records bad; a pending trial of X is cleared and the
#    untouched stable slot boots next by itself.
#  - get-primary prints the stable selection, never the trial target.
#  - get-current prints the firmware's booted slot from the device tree
#    (MUSE_PI_DEVICE_TREE, default /proc/device-tree), never a mount.
#
# Partition map (the ONE source of truth; tests read it from this file):
# controller-first, exactly Raspberry Pi's documented autoboot.txt A/B
# example (config_txt.html#autoboot-txt): physical partition 1 is the
# controller FAT holding only autoboot.txt (label muse-pi-ctl, NOT a RAUC
# slot), boot A is partition 2 and boot B is partition 3. autoboot.txt's
# boot_partition and the device tree's booted partition both use these
# physical numbers. The controller number is never a valid selection.
#
# Controller identity (OS2-OS1-CONTROLLER handoff in the certification):
# every command first checks that BOOT_DIR is a mount whose source resolves
# to the controller label (MUSE_PI_CTL_DEVICE, default
# /dev/disk/by-partlabel/muse-pi-ctl), read from MUSE_PROC_MOUNTINFO
# (default /proc/self/mountinfo). Anything else (unmounted, a boot slot
# mounted there, an unreadable table) refuses PI_TRYBOOT_NOT_CONTROLLER, so
# a selection can never be read from or written to a slot FAT. A mount point
# containing whitespace or backslashes (escaped in mountinfo) never matches
# and refuses (fail closed).
#
# Accepted file vocabulary (anything else is refused, never guessed):
#   sections [all] and [tryboot] only;
#   [all]: tryboot_a_b (=1), boot_partition (PART_A|PART_B), muse_trial
#          (none|A|B), muse_state_a and muse_state_b (good|bad);
#   [tryboot]: boot_partition (PART_A|PART_B).
# No comments, no carriage returns, no padded whitespace, no duplicate keys,
# no missing required key. Unknown content fails every command (fail closed).
#
# Device-tree contract (hardware receipt Q-M110-OS2-DT, see certification):
# `$MUSE_PI_DEVICE_TREE/chosen/bootloader/partition` holds the firmware's
# booted partition and `.../tryboot` (when present) the tryboot flag. Both
# are device-tree integers: exactly four bytes, big-endian binary (for
# example 00 00 00 02), NOT ASCII text. They are decoded with od(1), as
# upstream rpi-eeprom-update's readDtInt does; any other length or a value
# outside the map refuses (NO_CURRENT for the partition, MALFORMED for the
# flag). The tryboot flag (0|1) is validated only; it never changes the
# answer.
#
# Concurrency: every read-modify-write (set-primary, set-state) holds one
# exclusive flock on MUSE_PI_LOCK_FILE (default
# /run/muse-update/pi-tryboot.lock; the recipe creates /run/muse-update/).
# Readers take no lock (rename is the commit point; temp files are never
# read back).
#
# Writes go to a temp file in the same directory, are fsynced with
# `sync <file>`, renamed over autoboot.txt, and the directory is synced.
# FAT honesty (H15): FAT has no journal and rename is not atomic across
# power loss; the temp name (`autoboot.txt.muse-tmp-*`) is never read back,
# so a torn write leaves either the previous complete file or a stray temp
# file, never a half-parsed selection. A writer removes ONLY its own temp
# file (on every exit path, including TERM from the caller's time limit);
# another writer's stray is reported on stderr (PI_TRYBOOT_STRAY) and left
# for the recipe's boot-time cleanup, never deleted here.
#
# Environment: MUSE_PI_BOOT_DIR (default /boot/firmware),
# MUSE_PI_DEVICE_TREE (default /proc/device-tree),
# MUSE_PI_LOCK_FILE (default /run/muse-update/pi-tryboot.lock),
# MUSE_PI_CTL_DEVICE (default /dev/disk/by-partlabel/muse-pi-ctl),
# MUSE_PROC_MOUNTINFO (default /proc/self/mountinfo).

set -u

BOOT_DIR="${MUSE_PI_BOOT_DIR:-/boot/firmware}"
FILE="$BOOT_DIR/autoboot.txt"
DT_BASE="${MUSE_PI_DEVICE_TREE:-/proc/device-tree}"
LOCK_FILE="${MUSE_PI_LOCK_FILE:-/run/muse-update/pi-tryboot.lock}"
CTL_DEVICE="${MUSE_PI_CTL_DEVICE:-/dev/disk/by-partlabel/muse-pi-ctl}"
MOUNTINFO="${MUSE_PROC_MOUNTINFO:-/proc/self/mountinfo}"

# The partition map (see header). Change it here only.
PART_CONTROLLER=1
PART_A=2
PART_B=3

err() {
    echo "pi-tryboot-backend: PI_TRYBOOT_$1" >&2
    exit "${2:-3}"
}

to_num() {
    case "$1" in
        A) echo "$PART_A" ;;
        B) echo "$PART_B" ;;
        *) err "UNKNOWN_SLOT slot=$1" 2 ;;
    esac
}

# to_slot runs in a command substitution: callers must propagate its exit.
to_slot() {
    case "$1" in
        "$PART_A") echo A ;;
        "$PART_B") echo B ;;
        "$PART_CONTROLLER") err "MALFORMED boot_partition=$1 controller" ;;
        *) err "MALFORMED boot_partition=$1" ;;
    esac
}

other() {
    case "$1" in
        A) echo B ;;
        B) echo A ;;
        *) err "UNKNOWN_SLOT slot=$1" 2 ;;
    esac
}

check_slot() {
    case "$1" in
        A | B) ;;
        *) err "UNKNOWN_SLOT slot=$1" 2 ;;
    esac
}

# lock_acquire holds one exclusive flock on LOCK_FILE; every read-modify-write
# command must hold it across read_state and write_state. Readers take no lock.
lock_acquire() {
    lock_dir=${LOCK_FILE%/*}
    case "$lock_dir" in
        "" | "$LOCK_FILE") lock_dir="." ;;
    esac
    if [ ! -d "$lock_dir" ]; then
        err "NO_LOCK dir=$lock_dir"
    fi
    if ! command -v flock >/dev/null 2>&1; then
        err "NO_LOCK no-flock"
    fi
    # The redirection truncates or creates the lock file; the lock itself is
    # the flock, not the file contents.
    exec 9>"$LOCK_FILE" || err "NO_LOCK file=$LOCK_FILE"
    flock 9 || err "NO_LOCK flock"
}

lock_release() {
    exec 9>&- || err "NO_LOCK unlock"
}

# check_controller refuses unless BOOT_DIR is mounted from the controller
# label (the last mountinfo entry for the mount point wins, as in the kernel).
check_controller() {
    if [ ! -f "$MOUNTINFO" ] || [ ! -r "$MOUNTINFO" ]; then
        err "NOT_CONTROLLER mountinfo=$MOUNTINFO"
    fi
    want=$(readlink -f "$CTL_DEVICE" 2>/dev/null) || want=""
    if [ -z "$want" ] || [ ! -e "$want" ]; then
        err "NOT_CONTROLLER device=$CTL_DEVICE"
    fi
    src=$(awk -v mp="$BOOT_DIR" '
        $5 == mp { for (i = 7; i < NF; i++) if ($i == "-") { s = $(i + 2); break } }
        END { print s }' "$MOUNTINFO" 2>/dev/null) || err "NOT_CONTROLLER mountinfo-read"
    if [ -z "$src" ]; then
        err "NOT_CONTROLLER unmounted=$BOOT_DIR"
    fi
    got=$(readlink -f "$src" 2>/dev/null) || got=""
    if [ "$got" != "$want" ]; then
        err "NOT_CONTROLLER source=$src"
    fi
}

# read_state sets P_ALL, P_TRY, TRIAL, ST_A, ST_B or refuses.
read_state() {
    if [ ! -f "$FILE" ] || [ -L "$FILE" ]; then
        err "NO_BOOT_DIR file=$FILE"
    fi
    CR=$(printf '\r')
    section=""
    P_ALL=""
    P_TRY=""
    TRIAL="none"
    ST_A=""
    ST_B=""
    seen_flag=0
    seen_all_part=0
    seen_try_part=0
    seen_trial=0
    seen_sa=0
    seen_sb=0
    seen_section_all=0
    seen_section_try=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *"$CR"*) err "MALFORMED cr" ;;
            "") continue ;;
            "[all]")
                section="all"
                seen_section_all=1
                continue
                ;;
            "[tryboot]")
                section="try"
                seen_section_try=1
                continue
                ;;
            "[ "* | "["*"]"* | "\["*) err "MALFORMED section=$line" ;;
        esac
        case "$line" in
            \#* | \;*) err "MALFORMED comment" ;;
            *=*) ;;
            *) err "MALFORMED line=$line" ;;
        esac
        if [ -z "$section" ]; then
            err "MALFORMED outside-section"
        fi
        name=${line%%=*}
        value=${line#*=}
        case "$name" in
            *"$CR"* | *\ * | *"$(
                printf '\t'
            )"* | "") err "MALFORMED key=$name" ;;
        esac
        if [ "$section" = "all" ]; then
            case "$name" in
                tryboot_a_b)
                    [ "$seen_flag" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_flag=1
                    [ "$value" = "1" ] || err "MALFORMED tryboot_a_b=$value"
                    ;;
                boot_partition)
                    [ "$seen_all_part" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_all_part=1
                    P_ALL=$(to_slot "$value") || exit "$?"
                    ;;
                muse_trial)
                    [ "$seen_trial" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_trial=1
                    case "$value" in
                        none | A | B) TRIAL="$value" ;;
                        *) err "MALFORMED muse_trial=$value" ;;
                    esac
                    ;;
                muse_state_a)
                    [ "$seen_sa" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_sa=1
                    case "$value" in
                        good | bad) ST_A="$value" ;;
                        *) err "MALFORMED muse_state_a=$value" ;;
                    esac
                    ;;
                muse_state_b)
                    [ "$seen_sb" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_sb=1
                    case "$value" in
                        good | bad) ST_B="$value" ;;
                        *) err "MALFORMED muse_state_b=$value" ;;
                    esac
                    ;;
                *) err "MALFORMED key=$name" ;;
            esac
        else
            case "$name" in
                boot_partition)
                    [ "$seen_try_part" = "0" ] || err "MALFORMED duplicate=$name"
                    seen_try_part=1
                    P_TRY=$(to_slot "$value") || exit "$?"
                    ;;
                *) err "MALFORMED key=$name" ;;
            esac
        fi
    done <"$FILE"
    if [ "$seen_section_all" = "0" ] || [ "$seen_section_try" = "0" ]; then
        err "MALFORMED missing-section"
    fi
    if [ "$seen_flag" = "0" ] || [ "$seen_all_part" = "0" ] || [ "$seen_try_part" = "0" ]; then
        err "MALFORMED missing-key"
    fi
    if [ -z "$ST_A" ]; then
        if [ "$P_ALL" = "A" ]; then ST_A="good"; else ST_A="bad"; fi
    fi
    if [ -z "$ST_B" ]; then
        if [ "$P_ALL" = "B" ]; then ST_B="good"; else ST_B="bad"; fi
    fi
}

# write_state <primary> <tryboot> <trial> <state_a> <state_b>.
# The caller must hold the lock. Only this writer's own temp file is ever
# removed (EXIT/TERM trap until the rename commits it); another stray is
# reported, never deleted.
write_state() {
    w_all="$1"
    w_try="$2"
    w_trial="$3"
    w_sa="$4"
    w_sb="$5"
    for stray in "$FILE".muse-tmp-*; do
        if [ -f "$stray" ]; then
            echo "pi-tryboot-backend: PI_TRYBOOT_STRAY left=$stray" >&2
        fi
    done
    tmp=""
    trap 'if [ -n "$tmp" ]; then rm -f "$tmp"; fi' EXIT
    trap 'exit 143' TERM INT HUP
    tmp=$(mktemp "$FILE.muse-tmp-XXXXXX") || err "NO_BOOT_DIR mktemp"
    {
        printf '[all]\ntryboot_a_b=1\nboot_partition=%s\nmuse_trial=%s\nmuse_state_a=%s\nmuse_state_b=%s\n[tryboot]\nboot_partition=%s\n' \
            "$(to_num "$w_all")" "$w_trial" "$w_sa" "$w_sb" "$(to_num "$w_try")"
    } >"$tmp" || err "NO_BOOT_DIR write"
    sync "$tmp" || err "NO_BOOT_DIR fsync"
    mv -f "$tmp" "$FILE" || err "NO_BOOT_DIR rename"
    tmp=""
    sync "$BOOT_DIR" || err "NO_BOOT_DIR dirsync"
}

# dt_int <file> prints a device-tree integer: exactly four bytes, big-endian
# (upstream rpi-eeprom-update's readDtInt also decodes with od). Any other
# length, or an unreadable file, returns nonzero.
dt_int() {
    bytes=$(od -An -v -tu1 "$1" 2>/dev/null) || return 1
    # Word splitting of od's byte list is intended here.
    # shellcheck disable=SC2086
    set -- $bytes
    if [ "$#" != "4" ]; then
        return 1
    fi
    for byte in "$@"; do
        case "$byte" in
            '' | *[!0-9]*) return 1 ;;
        esac
    done
    echo $((($1 << 24) | ($2 << 16) | ($3 << 8) | $4))
}

# current_slot prints the firmware's booted slot from the device tree, never
# from a mount. A missing, unreadable, wrongly sized or unmapped partition
# record refuses NO_CURRENT; a present-but-malformed tryboot flag refuses
# MALFORMED.
current_slot() {
    part_file="$DT_BASE/chosen/bootloader/partition"
    try_file="$DT_BASE/chosen/bootloader/tryboot"
    if [ ! -f "$part_file" ] || [ -L "$part_file" ]; then
        err "NO_CURRENT partition=$part_file"
    fi
    part=$(dt_int "$part_file") || err "NO_CURRENT partition-not-dt-int"
    case "$part" in
        "$PART_A") slot="A" ;;
        "$PART_B") slot="B" ;;
        *) err "NO_CURRENT partition=$part" ;;
    esac
    if [ -e "$try_file" ] || [ -L "$try_file" ]; then
        if [ ! -f "$try_file" ] || [ -L "$try_file" ]; then
            err "MALFORMED tryboot-not-file"
        fi
        flag=$(dt_int "$try_file") || err "MALFORMED tryboot-not-dt-int"
        case "$flag" in
            0 | 1) ;;
            *) err "MALFORMED tryboot=$flag" ;;
        esac
    fi
    echo "$slot"
}

cmd="${1:-}"
check_controller
case "$cmd" in
    get-primary)
        [ "$#" = "1" ] || err "USAGE get-primary" 2
        read_state
        echo "$P_ALL"
        ;;
    get-trial)
        [ "$#" = "1" ] || err "USAGE get-trial" 2
        read_state
        echo "$TRIAL"
        ;;
    get-current)
        [ "$#" = "1" ] || err "USAGE get-current" 2
        read_state
        current_slot
        ;;
    set-primary)
        # RAUC's activation call (install.c after writing the slot; mark.c
        # mark-active). It ARMS a one-shot trial of the named slot and never
        # changes the stable selection. Naming the already-stable slot clears
        # any trial instead: there is nothing to try.
        [ "$#" = "2" ] || err "USAGE set-primary" 2
        check_slot "$2"
        lock_acquire
        read_state
        if [ "$2" = "$P_ALL" ]; then
            write_state "$P_ALL" "$(other "$P_ALL")" "none" "$ST_A" "$ST_B"
        elif [ "$2" = "A" ]; then
            write_state "$P_ALL" "A" "A" "$ST_A" "$ST_B"
        else
            write_state "$P_ALL" "B" "B" "$ST_A" "$ST_B"
        fi
        lock_release
        ;;
    get-state)
        [ "$#" = "2" ] || err "USAGE get-state" 2
        check_slot "$2"
        read_state
        if [ "$2" = "A" ]; then echo "$ST_A"; else echo "$ST_B"; fi
        ;;
    set-state)
        [ "$#" = "3" ] || err "USAGE set-state" 2
        check_slot "$2"
        case "$3" in
            good | bad) ;;
            *) err "BAD_STATE state=$3" 2 ;;
        esac
        lock_acquire
        read_state
        if [ "$3" = "good" ]; then
            if [ "$2" = "A" ]; then n_sa="good"; n_sb="$ST_B"; else n_sa="$ST_A"; n_sb="good"; fi
            # Trial passed while running the trial slot: promote. An unknown
            # current slot never promotes (fail closed); it only records.
            now=$(current_slot 2>/dev/null) || now=""
            if [ -n "$now" ] && [ "$TRIAL" = "$2" ] && [ "$now" = "$2" ]; then
                if [ "$2" = "A" ]; then
                    write_state "A" "B" "none" "$n_sa" "$n_sb"
                else
                    write_state "B" "A" "none" "$n_sa" "$n_sb"
                fi
            else
                write_state "$P_ALL" "$P_TRY" "$TRIAL" "$n_sa" "$n_sb"
            fi
        else
            if [ "$2" = "A" ]; then n_sa="bad"; n_sb="$ST_B"; else n_sa="$ST_A"; n_sb="bad"; fi
            if [ "$TRIAL" = "$2" ]; then
                write_state "$P_ALL" "$P_ALL" "none" "$n_sa" "$n_sb"
            else
                write_state "$P_ALL" "$P_TRY" "$TRIAL" "$n_sa" "$n_sb"
            fi
        fi
        lock_release
        ;;
    *) err "USAGE cmd=$cmd" 2 ;;
esac
