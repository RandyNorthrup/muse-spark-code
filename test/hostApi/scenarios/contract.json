{
  "protocol": "mhp/1.5.1",
  "backends": ["musecode", "modelapi"],
  "scenarios": [
    {
      "id": "conversation",
      "actions": [
        { "op": "send", "text": "first" },
        { "op": "send", "text": "second" }
      ],
      "expected": { "turns": ["first", "second"], "responses": 2 }
    },
    {
      "id": "approval",
      "actions": [
        { "op": "approval", "choice": "allow" },
        { "op": "approval", "choice": "deny" },
        { "op": "approval", "choice": "cancel" }
      ],
      "expected": { "executions": 1, "decisions": ["allow", "deny", "cancel"] }
    },
    {
      "id": "dirty-buffer",
      "actions": [
        { "op": "dirty", "value": true, "text": "dirtied" },
        { "op": "edit", "version": 2, "text": "bad" }
      ],
      "expected": {
        "text": "dirtied",
        "version": 2,
        "refusals": ["MHP_DIRTY_BUFFER"],
        "undoDepth": 1
      }
    },
    {
      "id": "atomic-edit",
      "actions": [
        { "op": "edit", "version": 1, "text": "changed" },
        { "op": "edit", "version": 1, "text": "duplicate" },
        { "op": "undo" }
      ],
      "expected": {
        "text": "original",
        "version": 3,
        "refusals": ["MHP_VERSION_CONFLICT"],
        "undoDepth": 0,
        "undoTransactions": 1
      }
    },
    {
      "id": "diff-hunks",
      "actions": [
        { "op": "hunk", "id": "one", "choice": "accept" },
        { "op": "hunk", "id": "two", "choice": "reject" }
      ],
      "expected": { "hunks": { "one": "accept", "two": "reject" }, "text": "l1c\nl2\nl3\n" }
    },
    {
      "id": "diagnostics",
      "actions": [
        { "op": "diagnostic", "message": "fixture error", "severity": "error" },
        { "op": "verify" }
      ],
      "expected": { "verifyErrors": ["fixture error"] }
    },
    {
      "id": "checkpoint",
      "actions": [
        { "op": "checkpoint" },
        { "op": "edit", "version": 1, "text": "changed" },
        { "op": "restore" }
      ],
      "expected": { "text": "original", "checkpoints": 1 }
    },
    {
      "id": "tab-completion",
      "actions": [{ "op": "completion", "text": "completion" }, { "op": "acceptCompletion" }],
      "expected": { "text": "originalcompletion", "acceptedCompletions": 1 }
    },
    {
      "id": "settings",
      "actions": [
        { "op": "setting", "key": "museSpark.paidDailyBudgetUsd", "value": 5 },
        { "op": "readSetting", "key": "museSpark.paidDailyBudgetUsd" }
      ],
      "expected": { "settingValue": 5 }
    },
    {
      "id": "session-reload",
      "actions": [{ "op": "send", "text": "kept" }, { "op": "reload" }],
      "expected": { "turns": ["kept"], "sameSession": true, "stateRequested": true }
    },
    {
      "id": "panel-order",
      "actions": [
        { "op": "panel", "seq": 1 },
        { "op": "panel", "seq": 1 },
        { "op": "panel", "seq": 3 },
        { "op": "panel", "seq": 2 }
      ],
      "expected": {
        "deliveredSequences": [1, 2],
        "refusals": ["MHP_PANEL_OUT_OF_ORDER", "MHP_PANEL_OUT_OF_ORDER"]
      }
    }
  ],
  "waiting": [
    {
      "backend": "musecode",
      "scenario": "conversation",
      "need": "lead-authorized live model calls with a named model and call count"
    },
    {
      "backend": "modelapi",
      "scenario": "conversation",
      "need": "Meta Model API key (C2) and lead-authorized live model calls"
    },
    {
      "backend": "musecode",
      "scenario": "approval",
      "need": "lead-authorized live model calls with a named model and call count"
    },
    {
      "backend": "modelapi",
      "scenario": "approval",
      "need": "Meta Model API key (C2) and lead-authorized live model calls"
    },
    {
      "backend": "musecode",
      "scenario": "session-reload",
      "need": "lead-authorized live model calls with a named model and call count"
    },
    {
      "backend": "modelapi",
      "scenario": "session-reload",
      "need": "Meta Model API key (C2) and lead-authorized live model calls"
    },
    {
      "backend": "musecode",
      "scenario": "tab-completion",
      "need": "lead-authorized live Tab generation with a named model and call count"
    },
    {
      "backend": "modelapi",
      "scenario": "tab-completion",
      "need": "Meta Model API key (C2) and lead-authorized live Tab generation"
    },
    {
      "backend": "musecode",
      "scenario": "checkpoint",
      "need": "Model-API-only checkpoint restore (the product refuses a Muse Code restore)"
    },
    {
      "backend": "musecode",
      "scenario": "dirty-buffer",
      "hosts": ["jetbrains", "eclipse"],
      "need": "per-document 1-based versions (unbuilt; the natives report platform modification stamps)"
    },
    {
      "backend": "modelapi",
      "scenario": "dirty-buffer",
      "hosts": ["jetbrains", "eclipse"],
      "need": "per-document 1-based versions (unbuilt; the natives report platform modification stamps)"
    },
    {
      "backend": "musecode",
      "scenario": "atomic-edit",
      "hosts": ["jetbrains", "eclipse"],
      "need": "per-document 1-based versions (unbuilt; the natives report platform modification stamps)"
    },
    {
      "backend": "modelapi",
      "scenario": "atomic-edit",
      "hosts": ["jetbrains", "eclipse"],
      "need": "per-document 1-based versions (unbuilt; the natives report platform modification stamps)"
    }
  ]
}
