{
  // Unit tests (vitest). Node + DOM libs because webview component tests run
  // under jsdom; `vscode` resolves to test/mocks/vscode.ts via the vitest alias
  // and to @types/vscode for type-checking, so mocks are checked against the
  // real API surface.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vscode", "vscode-webview", "@testing-library/jest-dom"]
  },
  "include": [
    "./**/*.ts",
    "../m104/runtime/**/*.ts",
    "../m104/engines/**/*.ts",
    "../m104/ui/**/*.ts",
    "../m104/ui/**/*.tsx",
    "./**/*.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../package.json"
  ]
}
