{
  // Unit tests (vitest). Node + DOM libs because webview component tests run
  // under jsdom. No `vscode` module exists outside the editor: a suite whose
  // code needs the editor API runs in test/integration, inside VS Code.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // `vite/client` types `import.meta.glob`, which the structural money
    // guard uses to load every schema module with vitest's normal loading.
    "types": ["node", "vscode", "vscode-webview", "@testing-library/jest-dom", "vite/client"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "../../package.json"
  ]
}
