{
  "name": "muse-spark-code",
  "displayName": "Muse Spark Code (Unofficial)",
  "description": "Unofficial VS Code chat panel for Meta's Muse Spark model, driven through the Muse Code CLI or a Meta Model API key.",
  "version": "0.0.0",
  "publisher": "RandyNorthrup",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/RandyNorthrup/muse-spark-code.git"
  },
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "muse",
    "muse spark",
    "meta",
    "ai",
    "chat",
    "coding agent"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museSpark",
          "title": "Muse Spark",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "museSpark": [
        {
          "type": "webview",
          "id": "museSpark.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "museSpark.openInSidebar",
        "title": "Open in Sidebar",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.openInNewTab",
        "title": "Open in New Tab",
        "category": "Muse Spark",
        "icon": "$(add)"
      },
      {
        "command": "museSpark.focusInput",
        "title": "Toggle Focus",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.insertMentionReference",
        "title": "Insert @-Mention for Selection",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.toggleFocusView",
        "title": "Toggle Focus View",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.toggleThinking",
        "title": "Toggle Thinking",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.setUpSandbox",
        "title": "Set Up Shell Sandbox",
        "category": "Muse Spark"
      }
    ],
    "keybindings": [
      {
        "command": "museSpark.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "museSpark.openInNewTab",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "museSpark.insertMentionReference",
        "key": "alt+k",
        "mac": "alt+k"
      },
      {
        "command": "museSpark.toggleFocusView",
        "key": "ctrl+alt+f",
        "mac": "ctrl+alt+f"
      },
      {
        "command": "museSpark.toggleThinking",
        "key": "ctrl+alt+t",
        "mac": "alt+t",
        "linux": "ctrl+alt+o",
        "when": "museSpark.inputFocused"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "museSpark.openInNewTab",
          "when": "view == museSpark.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Muse Spark",
      "properties": {
        "museSpark.preferredLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "panel"
          ],
          "enumDescriptions": [
            "Open new conversations in the Muse Spark sidebar view.",
            "Open new conversations as editor tabs."
          ],
          "default": "panel",
          "description": "Where new conversations open."
        },
        "museSpark.initialPermissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Manual: ask before most actions.",
            "Edit automatically: auto-approve file edits and common filesystem commands.",
            "Plan: research only until the plan is approved.",
            "Auto: the host reviews actions and prompts only when needed.",
            "Bypass permissions: everything without asking (use only in sandboxes)."
          ],
          "default": "manual",
          "description": "Permission mode for new conversations."
        },
        "museSpark.archiveInactiveSessions": {
          "type": "number",
          "enum": [
            1,
            2,
            7,
            14,
            0
          ],
          "enumDescriptions": [
            "Hide sessions idle for a day.",
            "Hide sessions idle for two days.",
            "Hide sessions idle for a week.",
            "Hide sessions idle for two weeks.",
            "Never hide sessions."
          ],
          "default": 14,
          "description": "Hide sessions idle for this many days from the History dialog (they stay on disk; Show archived lists them)."
        },
        "museSpark.shellSandbox": {
          "type": "string",
          "enum": [
            "auto",
            "muse",
            "off"
          ],
          "enumDescriptions": [
            "Use Muse Code's OS sandbox for shell commands, except on Windows for a workspace under your user profile, where the sandbox cannot run commands (they run directly as you there, still gated by approvals).",
            "Always use Muse Code's OS sandbox for shell commands.",
            "Never sandbox shell commands: they run directly as you, gated by the approval cards, as in Claude Code. Muse Code then also lets file tools write outside the workspace."
          ],
          "default": "auto",
          "description": "Whether shell commands run inside Muse Code's OS sandbox. Changing it restarts the Muse Code host."
        },
        "museSpark.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Save dirty files before Muse reads or writes them."
        },
        "museSpark.attachOpenFile": {
          "type": "boolean",
          "default": true,
          "description": "Attach the active file to each message. Turn off to attach only the selection."
        },
        "museSpark.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Send with Ctrl+Enter (Cmd+Enter on macOS) instead of Enter."
        },
        "museSpark.hideOnboarding": {
          "type": "boolean",
          "default": false,
          "description": "Hide the onboarding checklist in new conversations."
        },
        "museSpark.focusView": {
          "type": "boolean",
          "default": false,
          "description": "Focus view: hide tool calls and reasoning, show only prompts and responses."
        },
        "museSpark.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "Exclude .gitignore patterns from file searches and @-mentions."
        },
        "museSpark.confidentialWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Treat this workspace as confidential: contributor-tier models (whose traffic Meta may use for training) are blocked."
        },
        "museSpark.allowDangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Allow dangerously skip permissions: list Bypass permissions in the Modes menu. Muse then edits files and runs commands without asking; use only in a sandbox."
        },
        "museSpark.museBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Muse Code executable. Leave empty to discover it on PATH or in the default install directory."
        },
        "museSpark.environmentVariables": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Variable name."
              },
              "value": {
                "type": "string",
                "description": "Variable value."
              }
            },
            "additionalProperties": false
          },
          "description": "Environment variables set for the Muse Code process. Do not put API keys here; use the Sign in flow, which stores them in secret storage."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.mjs --production && node scripts/check-bundle-size.mjs",
    "build:dev": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "harness:shots": "node scripts/harness-shots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "run-s lint:js lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "typecheck": "run-s typecheck:host typecheck:webview typecheck:unit typecheck:integration",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p src/webview/tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p test/unit/tsconfig.json --noEmit",
    "typecheck:integration": "tsc -p test/integration/tsconfig.json --noEmit",
    "deadcode": "knip",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 -T src/extension.ts src/webview/main.tsx",
    "duplication": "jscpd",
    "test": "run-s test:unit test:integration",
    "test:unit": "vitest run --coverage",
    "test:integration": "run-s build:dev test:integration:run",
    "test:integration:run": "vscode-test",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git --redact --no-banner .",
    "quality:gates": "run-s format:check lint typecheck deadcode cycles duplication test:unit build security:audit",
    "quality": "run-s quality:gates security:secrets security:sast",
    "quality:ci": "run-s quality:gates test:integration",
    "package": "vsce package --no-dependencies",
    "prepare": "husky",
    "security:sast": "semgrep scan --config auto --error --exclude=dist --exclude=coverage --exclude=node_modules --exclude=.vscode-test"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@muse-code/sdk": "1.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.134.0",
    "@types/vscode-webview": "1.57.5",
    "@vitest/coverage-v8": "5.0.1",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "dpdm": "4.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "76.0.0",
    "husky": "9.1.7",
    "jscpd": "5.3.1",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "serialize-javascript": "7.1.1",
    "diff": "8.0.3"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
