{
  "name": "muse-spark-code",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.12.1",
  "publisher": "RandyNorthrup",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RandyNorthrup/muse-spark-code.git"
  },
  "homepage": "https://github.com/RandyNorthrup/muse-spark-code#readme",
  "bugs": {
    "url": "https://github.com/RandyNorthrup/muse-spark-code/issues"
  },
  "sponsor": {
    "url": "https://www.paypal.com/donate/?hosted_button_id=Q9VC7B42R7K82"
  },
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "muse spark",
    "muse code",
    "meta",
    "meta ai",
    "ai",
    "chat",
    "coding agent",
    "agent",
    "assistant",
    "voice dictation",
    "mcp",
    "pdf"
  ],
  "galleryBanner": {
    "color": "#16181f",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "activationEvents": [
    "onWebviewPanel:museSpark.chatPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museSpark",
          "title": "%viewsContainers.museSpark.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "museSpark": [
        {
          "type": "webview",
          "id": "museSpark.chatView",
          "name": "%views.chatView.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "museSpark.openInSidebar",
        "title": "%command.openInSidebar.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.openInNewTab",
        "title": "%command.openInNewTab.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "museSpark.focusInput",
        "title": "%command.focusInput.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.insertMentionReference",
        "title": "%command.insertMentionReference.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.toggleFocusView",
        "title": "%command.toggleFocusView.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.toggleThinking",
        "title": "%command.toggleThinking.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.setUpSandbox",
        "title": "%command.setUpSandbox.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.diagnostics",
        "title": "%command.diagnostics.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.newConversation",
        "title": "%command.newConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.signOut",
        "title": "%command.signOut.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.openInTerminal",
        "title": "%command.openInTerminal.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.createRulesFile",
        "title": "%command.createRulesFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.manageSkills",
        "title": "%command.manageSkills.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.importSkills",
        "title": "%command.importSkills.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.importFromAgents",
        "title": "%command.importFromAgents.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.exportConversation",
        "title": "%command.exportConversation.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.importSession",
        "title": "%command.importSession.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.openShareFile",
        "title": "%command.openShareFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.mcpServers",
        "title": "%command.mcpServers.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.hooks",
        "title": "%command.hooks.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.memory",
        "title": "%command.memory.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.newWorktree",
        "title": "%command.newWorktree.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.removeWorktree",
        "title": "%command.removeWorktree.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.moveToBackground",
        "title": "%command.moveToBackground.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.stopBackgroundTasks",
        "title": "%command.stopBackgroundTasks.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.restartMuseCode",
        "title": "%command.restartMuseCode.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.installBundledSkills",
        "title": "%command.installBundledSkills.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.removeBundledSkills",
        "title": "%command.removeBundledSkills.title%",
        "category": "%command.category%"
      }
    ],
    "keybindings": [
      {
        "command": "museSpark.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "win": "ctrl+alt+escape"
      },
      {
        "command": "museSpark.openInNewTab",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+alt+escape"
      },
      {
        "command": "museSpark.insertMentionReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "museSpark.toggleFocusView",
        "key": "ctrl+alt+f",
        "mac": "ctrl+alt+f",
        "when": "activeWebviewPanelId == 'museSpark.chatPanel' || focusedView == 'museSpark.chatView'"
      },
      {
        "command": "museSpark.toggleThinking",
        "key": "ctrl+alt+t",
        "mac": "alt+t",
        "linux": "ctrl+alt+o",
        "when": "museSpark.inputFocused"
      },
      {
        "command": "museSpark.newConversation",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "config.museSpark.enableNewConversationShortcut && (activeWebviewPanelId == 'museSpark.chatPanel' || focusedView == 'museSpark.chatView')"
      },
      {
        "command": "museSpark.moveToBackground",
        "key": "ctrl+b",
        "mac": "ctrl+b",
        "when": "museSpark.canMoveToBackground && (activeWebviewPanelId == 'museSpark.chatPanel' || focusedView == 'museSpark.chatView')"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "museSpark.insertMentionReference",
          "when": "editorIsOpen"
        },
        {
          "command": "museSpark.toggleThinking",
          "when": "activeWebviewPanelId == 'museSpark.chatPanel' || view.museSpark.chatView.visible"
        },
        {
          "command": "museSpark.setUpSandbox",
          "when": "isWindows || remoteName"
        },
        {
          "command": "museSpark.createRulesFile",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "museSpark.exportConversation",
          "when": "activeWebviewPanelId == 'museSpark.chatPanel' || view.museSpark.chatView.visible"
        },
        {
          "command": "museSpark.importSession",
          "when": "activeWebviewPanelId == 'museSpark.chatPanel' || view.museSpark.chatView.visible"
        },
        {
          "command": "museSpark.openShareFile",
          "when": "activeWebviewPanelId == 'museSpark.chatPanel' || view.museSpark.chatView.visible"
        },
        {
          "command": "museSpark.newWorktree",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "museSpark.removeWorktree",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "museSpark.moveToBackground",
          "when": "museSpark.canMoveToBackground"
        },
        {
          "command": "museSpark.stopBackgroundTasks",
          "when": "activeWebviewPanelId == 'museSpark.chatPanel' || view.museSpark.chatView.visible"
        }
      ],
      "view/title": [
        {
          "command": "museSpark.openInNewTab",
          "when": "view == museSpark.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "museSpark.preferredLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "panel"
          ],
          "enumDescriptions": [
            "%config.preferredLocation.enumDescriptions.sidebar%",
            "%config.preferredLocation.enumDescriptions.panel%"
          ],
          "default": "panel",
          "description": "%config.preferredLocation.description%"
        },
        "museSpark.initialPermissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "%config.initialPermissionMode.enumDescriptions.manual%",
            "%config.initialPermissionMode.enumDescriptions.acceptEdits%",
            "%config.initialPermissionMode.enumDescriptions.plan%",
            "%config.initialPermissionMode.enumDescriptions.auto%",
            "%config.initialPermissionMode.enumDescriptions.bypassPermissions%"
          ],
          "default": "manual",
          "description": "%config.initialPermissionMode.description%",
          "scope": "machine"
        },
        "museSpark.archiveInactiveSessions": {
          "type": "number",
          "enum": [
            1,
            2,
            7,
            14,
            0
          ],
          "enumDescriptions": [
            "%config.archiveInactiveSessions.enumDescriptions.1%",
            "%config.archiveInactiveSessions.enumDescriptions.2%",
            "%config.archiveInactiveSessions.enumDescriptions.7%",
            "%config.archiveInactiveSessions.enumDescriptions.14%",
            "%config.archiveInactiveSessions.enumDescriptions.0%"
          ],
          "default": 14,
          "description": "%config.archiveInactiveSessions.description%"
        },
        "museSpark.cleanupPeriodDays": {
          "type": "integer",
          "minimum": 0,
          "default": 30,
          "description": "%config.cleanupPeriodDays.description%"
        },
        "museSpark.backend": {
          "type": "string",
          "enum": [
            "auto",
            "museCode",
            "modelApi"
          ],
          "enumDescriptions": [
            "%config.backend.enumDescriptions.auto%",
            "%config.backend.enumDescriptions.museCode%",
            "%config.backend.enumDescriptions.modelApi%"
          ],
          "default": "auto",
          "description": "%config.backend.description%",
          "scope": "machine"
        },
        "museSpark.shellSandbox": {
          "type": "string",
          "enum": [
            "auto",
            "muse",
            "off"
          ],
          "enumDescriptions": [
            "%config.shellSandbox.enumDescriptions.auto%",
            "%config.shellSandbox.enumDescriptions.muse%",
            "%config.shellSandbox.enumDescriptions.off%"
          ],
          "default": "auto",
          "description": "%config.shellSandbox.description%",
          "scope": "machine"
        },
        "museSpark.sandboxNetwork": {
          "type": "string",
          "enum": [
            "default",
            "proxy-only",
            "restricted",
            "enabled"
          ],
          "enumDescriptions": [
            "%config.sandboxNetwork.enumDescriptions.default%",
            "%config.sandboxNetwork.enumDescriptions.proxyOnly%",
            "%config.sandboxNetwork.enumDescriptions.restricted%",
            "%config.sandboxNetwork.enumDescriptions.enabled%"
          ],
          "default": "default",
          "description": "%config.sandboxNetwork.description%",
          "scope": "machine"
        },
        "museSpark.autosave": {
          "type": "boolean",
          "default": true,
          "description": "%config.autosave.description%"
        },
        "museSpark.attachOpenFile": {
          "type": "boolean",
          "default": true,
          "description": "%config.attachOpenFile.description%"
        },
        "museSpark.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "%config.useCtrlEnterToSend.description%"
        },
        "museSpark.hideOnboarding": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideOnboarding.description%"
        },
        "museSpark.focusView": {
          "type": "boolean",
          "default": false,
          "description": "%config.focusView.description%"
        },
        "museSpark.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "%config.respectGitIgnore.description%"
        },
        "museSpark.confidentialWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "%config.confidentialWorkspace.description%"
        },
        "museSpark.allowDangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowDangerouslySkipPermissions.description%",
          "scope": "machine"
        },
        "museSpark.museBinaryPath": {
          "type": "string",
          "default": "",
          "description": "%config.museBinaryPath.description%",
          "scope": "machine"
        },
        "museSpark.environmentVariables": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.environmentVariables.name.description%"
              },
              "value": {
                "type": "string",
                "description": "%config.environmentVariables.value.description%"
              }
            },
            "additionalProperties": false
          },
          "description": "%config.environmentVariables.description%",
          "scope": "machine"
        },
        "museSpark.enableNewConversationShortcut": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableNewConversationShortcut.description%"
        },
        "museSpark.modelApiWebSearch": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiWebSearch.description%",
          "scope": "machine"
        },
        "museSpark.modelApiImageGeneration": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiImageGeneration.description%",
          "scope": "machine"
        },
        "museSpark.modelApiVoice": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiVoice.description%",
          "scope": "machine"
        },
        "museSpark.modelApiPromptCacheRetention": {
          "type": "string",
          "enum": [
            "in_memory",
            "24h"
          ],
          "enumDescriptions": [
            "%config.modelApiPromptCacheRetention.enumDescriptions.inMemory%",
            "%config.modelApiPromptCacheRetention.enumDescriptions.24h%"
          ],
          "default": "in_memory",
          "description": "%config.modelApiPromptCacheRetention.description%",
          "scope": "machine"
        },
        "museSpark.modelApiScheduledPrompts": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiScheduledPrompts.description%",
          "scope": "machine"
        },
        "museSpark.modelApiSubagents": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiSubagents.description%",
          "scope": "machine"
        },
        "museSpark.modelApiBestOfN": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiBestOfN.description%",
          "scope": "machine"
        },
        "museSpark.modelApiHooks": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiHooks.description%",
          "scope": "machine"
        },
        "museSpark.diagnosticsAfterEdits": {
          "type": "boolean",
          "default": true,
          "description": "%config.diagnosticsAfterEdits.description%",
          "scope": "machine"
        },
        "museSpark.checkCommands": {
          "type": "array",
          "default": [],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "%config.checkCommands.name.description%"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "%config.checkCommands.command.description%"
              },
              "changedFiles": {
                "type": "boolean",
                "default": false,
                "description": "%config.checkCommands.changedFiles.description%"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "default": 300,
                "description": "%config.checkCommands.timeoutSeconds.description%"
              }
            },
            "additionalProperties": false
          },
          "description": "%config.checkCommands.description%",
          "scope": "machine"
        },
        "museSpark.formatOnEdit": {
          "type": "boolean",
          "default": false,
          "description": "%config.formatOnEdit.description%",
          "scope": "machine"
        },
        "museSpark.notifyOnBackgroundTurn": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOnBackgroundTurn.description%"
        },
        "museSpark.modelApiReplyUsage": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiReplyUsage.description%"
        },
        "museSpark.modelApiSessionBudgetUsd": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "%config.modelApiSessionBudgetUsd.description%",
          "scope": "machine"
        },
        "museSpark.modelApiRepoMap": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiRepoMap.description%",
          "scope": "machine"
        },
        "museSpark.modelApiObservationPacking": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiObservationPacking.description%",
          "scope": "machine"
        },
        "museSpark.turnCheckpoints": {
          "type": "boolean",
          "default": true,
          "description": "%config.turnCheckpoints.description%",
          "scope": "machine"
        },
        "museSpark.bundledSkills": {
          "type": "boolean",
          "default": true,
          "description": "%config.bundledSkills.description%",
          "scope": "machine"
        },
        "museSpark.modelApiCommandRules": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.modelApiCommandRules.markdownDescription%",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "decision",
              "match"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 1,
                "maxItems": 32
              },
              "decision": {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "forbid"
                ]
              },
              "shell": {
                "type": "string",
                "enum": [
                  "bash",
                  "powershell"
                ]
              },
              "justification": {
                "type": "string",
                "maxLength": 300
              },
              "match": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "minItems": 1,
                "maxItems": 20
              },
              "notMatch": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "maxItems": 20
              }
            }
          },
          "scope": "machine"
        },
        "museSpark.modelApiPermissionProfiles": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.modelApiPermissionProfiles.markdownDescription%",
          "maxProperties": 50,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "denyRead": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 200
              },
              "extraRoots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              }
            }
          },
          "scope": "machine"
        },
        "museSpark.modelApiPermissionProfile": {
          "type": "string",
          "default": "",
          "maxLength": 64,
          "markdownDescription": "%config.modelApiPermissionProfile.markdownDescription%",
          "scope": "machine"
        },
        "museSpark.modelApiRepositoryRules": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.modelApiRepositoryRules.markdownDescription%",
          "additionalProperties": false,
          "properties": {
            "commandRules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "pattern",
                  "decision",
                  "match"
                ],
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "ask",
                      "forbid"
                    ]
                  },
                  "shell": {
                    "type": "string",
                    "enum": [
                      "bash",
                      "powershell"
                    ]
                  },
                  "justification": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "match": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "notMatch": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "maxItems": 20
                  }
                }
              },
              "maxItems": 500
            },
            "denyRead": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 200
            }
          }
        },
        "museSpark.modelApiAutoReviewer": {
          "type": "boolean",
          "default": false,
          "description": "%config.modelApiAutoReviewer.description%",
          "scope": "machine"
        },
        "museSpark.museCodeAutoReviewer": {
          "type": "boolean",
          "default": true,
          "description": "%config.museCodeAutoReviewer.description%",
          "scope": "machine"
        },
        "museSpark.legalHeaderPolicy": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "off"
          ],
          "enumDescriptions": [
            "%config.legalHeaderPolicy.enumDescriptions.required%",
            "%config.legalHeaderPolicy.enumDescriptions.optional%",
            "%config.legalHeaderPolicy.enumDescriptions.off%"
          ],
          "default": "optional",
          "description": "%config.legalHeaderPolicy.description%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "museSpark.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "welcome",
            "title": "%walkthrough.gettingStarted.step.welcome.title%",
            "description": "%walkthrough.gettingStarted.step.welcome.description%",
            "media": {
              "markdown": "resources/walkthrough/welcome.md"
            }
          },
          {
            "id": "open",
            "title": "%walkthrough.gettingStarted.step.open.title%",
            "description": "%walkthrough.gettingStarted.step.open.description%",
            "media": {
              "markdown": "resources/walkthrough/open.md"
            },
            "completionEvents": [
              "onView:museSpark.chatView",
              "onCommand:museSpark.openInSidebar",
              "onCommand:museSpark.openInNewTab"
            ]
          },
          {
            "id": "signIn",
            "title": "%walkthrough.gettingStarted.step.signIn.title%",
            "description": "%walkthrough.gettingStarted.step.signIn.description%",
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:museSpark.signedIn"
            ]
          },
          {
            "id": "chat",
            "title": "%walkthrough.gettingStarted.step.chat.title%",
            "description": "%walkthrough.gettingStarted.step.chat.description%",
            "media": {
              "markdown": "resources/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:museSpark.createRulesFile"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.mjs --production && node scripts/check-bundle-size.mjs && node scripts/check-bundle-split.mjs && node scripts/check-host-globals.mjs && node scripts/third-party-notices.mjs",
    "notices": "node scripts/build.mjs --production && node scripts/third-party-notices.mjs --write",
    "build:dev": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "harness:shots": "node scripts/harness-shots.mjs",
    "harness:pseudo": "node scripts/pseudo-l10n.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "check:l10n": "node scripts/check-l10n.mjs",
    "check:host-api": "node scripts/check-host-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "run-s lint:js lint:css lint:ps",
    "lint:js": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:ps": "node scripts/lint-ps.mjs",
    "typecheck": "run-s typecheck:host typecheck:webview typecheck:unit typecheck:e2e typecheck:integration",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p src/webview/tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p test/unit/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "typecheck:integration": "tsc -p test/integration/tsconfig.json --noEmit",
    "deadcode": "knip",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 -T src/core/legal/entry.ts src/extension.ts src/host/backend/modelApiEntry.ts src/host/sessionBoardEntry.ts src/core/backends/modelapi/reviewerEntry.ts src/host/agentImportEntry.ts src/host/ide/codeIntelEntry.ts src/host/voice/voiceEntry.ts src/host/web/webFetchEntry.ts src/host/planMarkdownEntry.ts src/host/checkpoints/checkpointStoreEntry.ts src/host/review/reviewEntry.ts src/host/review/museCodeReviewerEntry.ts src/host/skills/bundledSkillsEntry.ts src/webview/main.tsx src/runtime/main.ts",
    "duplication": "jscpd",
    "test": "run-s test:unit test:integration",
    "test:unit": "vitest run --coverage",
    "test:e2e:live": "vitest run test/e2e/live.e2e.test.ts",
    "test:e2e:live:modelapi": "vitest run test/e2e/modelApi.live.e2e.test.ts",
    "test:e2e:live:eval": "vitest run test/e2e/eval.live.e2e.test.ts",
    "test:integration": "run-s build:dev test:integration:run",
    "test:integration:run": "vscode-test",
    "security:audit": "node scripts/audit.mjs",
    "security:secrets": "gitleaks git --redact --no-banner .",
    "quality:gates": "run-s format:check lint typecheck check:l10n check:host-api deadcode cycles duplication test:unit build security:audit",
    "quality": "run-s quality:gates test:a11y security:secrets security:sast",
    "quality:ci": "run-s quality:gates test:a11y test:integration",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "package:acp": "node scripts/build.mjs --production && node scripts/exec-schema.mjs --check && node scripts/package-acp.mjs",
    "images": "node scripts/render-images.mjs",
    "prepare": "husky",
    "security:sast": "node scripts/sast.mjs",
    "schema:exec": "node scripts/exec-schema.mjs"
  },
  "lint-staged": {
    "{*.{ts,tsx,mjs},!(vendor)/**/*.{ts,tsx,mjs}}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "{*.css,!(vendor)/**/*.css}": [
      "stylelint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "{*.{json,jsonc,md,yml,yaml},!(vendor)/**/*.{json,jsonc,md,yml,yaml}}": "prettier --write"
  },
