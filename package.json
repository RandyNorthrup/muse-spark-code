{
  "name": "muse-spark-code",
  "displayName": "Muse Spark Code (Unofficial)",
  "description": "Meta's Muse Spark as a coding agent inside VS Code: streaming chat, tool calls with diffs, permission modes, session history and voice dictation, on your Muse subscription (Muse Code CLI) or a Model API key. Unofficial.",
  "version": "0.4.0",
  "publisher": "RandyNorthrup",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RandyNorthrup/muse-spark-code.git"
  },
  "homepage": "https://github.com/RandyNorthrup/muse-spark-code#readme",
  "bugs": {
    "url": "https://github.com/RandyNorthrup/muse-spark-code/issues"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "muse spark",
    "muse code",
    "meta",
    "meta ai",
    "ai",
    "chat",
    "coding agent",
    "agent",
    "assistant",
    "voice dictation"
  ],
  "galleryBanner": {
    "color": "#16181f",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Muse Spark Code needs a real file system: the Muse Code CLI and the built-in tools read and write workspace files directly."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the agent does not load the workspace's rules (AGENTS.md), skills or memory, and runs no shell commands. Trust the workspace to enable them. The settings that choose what runs and what is billed are machine-scoped, so no workspace can set them."
    }
  },
  "activationEvents": [
    "onWebviewPanel:museSpark.chatPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museSpark",
          "title": "Muse Spark",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "museSpark": [
        {
          "type": "webview",
          "id": "museSpark.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "museSpark.openInSidebar",
        "title": "Open in Sidebar",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.openInNewTab",
        "title": "Open in New Tab",
        "category": "Muse Spark",
        "icon": "$(add)"
      },
      {
        "command": "museSpark.focusInput",
        "title": "Toggle Focus",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.insertMentionReference",
        "title": "Insert @-Mention for Selection",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.toggleFocusView",
        "title": "Toggle Focus View",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.toggleThinking",
        "title": "Toggle Thinking",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.setUpSandbox",
        "title": "Set Up Shell Sandbox",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.showLogs",
        "title": "Show Logs",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.diagnostics",
        "title": "Diagnostics",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.newConversation",
        "title": "New Conversation",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.signOut",
        "title": "Sign Out",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.openInTerminal",
        "title": "Open in Terminal",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.createRulesFile",
        "title": "Create AGENTS.md",
        "category": "Muse Spark"
      },
      {
        "command": "museSpark.openWalkthrough",
        "title": "Open Walkthrough",
        "category": "Muse Spark"
      }
    ],
    "keybindings": [
      {
        "command": "museSpark.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "museSpark.openInNewTab",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "museSpark.insertMentionReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "museSpark.toggleFocusView",
        "key": "ctrl+alt+f",
        "mac": "ctrl+alt+f",
        "when": "activeWebviewPanelId == 'museSpark.chatPanel' || focusedView == 'museSpark.chatView'"
      },
      {
        "command": "museSpark.toggleThinking",
        "key": "ctrl+alt+t",
        "mac": "alt+t",
        "linux": "ctrl+alt+o",
        "when": "museSpark.inputFocused"
      },
      {
        "command": "museSpark.newConversation",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "config.museSpark.enableNewConversationShortcut && (activeWebviewPanelId == 'museSpark.chatPanel' || focusedView == 'museSpark.chatView')"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "museSpark.openInNewTab",
          "when": "view == museSpark.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Muse Spark",
      "properties": {
        "museSpark.preferredLocation": {
          "type": "string",
          "enum": [
            "sidebar",
            "panel"
          ],
          "enumDescriptions": [
            "Open new conversations in the Muse Spark sidebar view.",
            "Open new conversations as editor tabs."
          ],
          "default": "panel",
          "description": "Where new conversations open."
        },
        "museSpark.initialPermissionMode": {
          "type": "string",
          "enum": [
            "manual",
            "acceptEdits",
            "plan",
            "auto",
            "bypassPermissions"
          ],
          "enumDescriptions": [
            "Manual: ask before most actions.",
            "Edit automatically: auto-approve file edits and common filesystem commands.",
            "Plan: research only until the plan is approved.",
            "Auto: the host reviews actions and prompts only when needed.",
            "Bypass permissions: everything without asking (use only in sandboxes)."
          ],
          "default": "manual",
          "description": "Permission mode for new conversations.",
          "scope": "machine"
        },
        "museSpark.archiveInactiveSessions": {
          "type": "number",
          "enum": [
            1,
            2,
            7,
            14,
            0
          ],
          "enumDescriptions": [
            "Hide sessions idle for a day.",
            "Hide sessions idle for two days.",
            "Hide sessions idle for a week.",
            "Hide sessions idle for two weeks.",
            "Never hide sessions."
          ],
          "default": 14,
          "description": "Hide sessions idle for this many days from the History dialog (they stay on disk; Show archived lists them)."
        },
        "museSpark.backend": {
          "type": "string",
          "enum": [
            "auto",
            "museCode",
            "modelApi"
          ],
          "enumDescriptions": [
            "Muse Code when the CLI is installed and signed in (billed to your Muse subscription); otherwise the Meta Model API with your pasted key.",
            "Always the Muse Code CLI, with its own sign-in.",
            "Always the Meta Model API with the key you pasted (pay as you go), using the extension's own tools."
          ],
          "default": "auto",
          "description": "Which backend hosts conversations. The pasted Model API key is never handed to the Muse Code CLI, so subscription work is never billed to the key.",
          "scope": "machine"
        },
        "museSpark.shellSandbox": {
          "type": "string",
          "enum": [
            "auto",
            "muse",
            "off"
          ],
          "enumDescriptions": [
            "Use Muse Code's OS sandbox for shell commands, except on Windows for a workspace under your user profile, where the sandbox cannot run commands (they run directly as you there, still gated by approvals).",
            "Always use Muse Code's OS sandbox for shell commands.",
            "Never sandbox shell commands: they run directly as you, gated by the approval cards, as in Claude Code. Muse Code then also lets file tools write outside the workspace."
          ],
          "default": "auto",
          "description": "Whether shell commands run inside Muse Code's OS sandbox. Changing it restarts the Muse Code host.",
          "scope": "machine"
        },
        "museSpark.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Save dirty files before Muse reads or writes them."
        },
        "museSpark.attachOpenFile": {
          "type": "boolean",
          "default": true,
          "description": "Attach the active file to each message. Turn off to attach only the selection."
        },
        "museSpark.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Send with Ctrl+Enter (Cmd+Enter on macOS) instead of Enter."
        },
        "museSpark.hideOnboarding": {
          "type": "boolean",
          "default": false,
          "description": "Hide the onboarding checklist in new conversations."
        },
        "museSpark.focusView": {
          "type": "boolean",
          "default": false,
          "description": "Focus view: hide tool calls and reasoning, show only prompts and responses."
        },
        "museSpark.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "description": "Exclude .gitignore patterns from file searches and @-mentions."
        },
        "museSpark.confidentialWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Treat this workspace as confidential: contributor-tier models (whose traffic Meta may use for training) are blocked."
        },
        "museSpark.allowDangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Allow dangerously skip permissions: list Bypass permissions in the Modes menu. Muse then edits files and runs commands without asking; use only in a sandbox.",
          "scope": "machine"
        },
        "museSpark.museBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Muse Code executable. Leave empty to discover it on PATH or in the default install directory.",
          "scope": "machine"
        },
        "museSpark.environmentVariables": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Variable name."
              },
              "value": {
                "type": "string",
                "description": "Variable value."
              }
            },
            "additionalProperties": false
          },
          "description": "Environment variables set for the Muse Code process. Do not put API keys here; use the Sign in flow, which stores them in secret storage.",
          "scope": "machine"
        },
        "museSpark.enableNewConversationShortcut": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl+N (Cmd+N on macOS) to start a new conversation while a Muse Spark panel is focused."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "museSpark.gettingStarted",
        "title": "Get started with Muse Spark",
        "description": "Meta's Muse Spark as a coding agent in VS Code: open the panel, sign in, chat about your code.",
        "steps": [
          {
            "id": "welcome",
            "title": "Your coding agent",
            "description": "Muse Spark reads your files, edits them under the permission mode you choose, runs commands with your approval, and follows the workspace’s AGENTS.md rules and skills.",
            "media": {
              "markdown": "resources/walkthrough/welcome.md"
            }
          },
          {
            "id": "open",
            "title": "Open the panel",
            "description": "Click the Muse Spark icon in the activity bar, or press Ctrl+Shift+Escape (Cmd+Shift+Escape on macOS) for a conversation in an editor tab.\n[Open Muse Spark](command:museSpark.openInSidebar)",
            "media": {
              "markdown": "resources/walkthrough/open.md"
            },
            "completionEvents": [
              "onView:museSpark.chatView",
              "onCommand:museSpark.openInSidebar",
              "onCommand:museSpark.openInNewTab"
            ]
          },
          {
            "id": "signIn",
            "title": "Sign in",
            "description": "Sign in with your Meta account through the Muse Code CLI (billed to your Muse subscription), or paste a Model API key from dev.meta.ai (pay as you go).",
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:museSpark.signedIn"
            ]
          },
          {
            "id": "chat",
            "title": "Chat, mention files, pick a mode",
            "description": "Type a message and press Enter. / opens the palette, @ mentions a file, Shift+Tab cycles the permission mode, and the History dialog brings past conversations back.\n[Create AGENTS.md](command:museSpark.createRulesFile)",
            "media": {
              "markdown": "resources/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:museSpark.createRulesFile"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.mjs --production && node scripts/check-bundle-size.mjs",
    "build:dev": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "harness:shots": "node scripts/harness-shots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "run-s lint:js lint:css lint:ps",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:ps": "node scripts/lint-ps.mjs",
    "typecheck": "run-s typecheck:host typecheck:webview typecheck:unit typecheck:e2e typecheck:integration",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p src/webview/tsconfig.json --noEmit",
    "typecheck:unit": "tsc -p test/unit/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "typecheck:integration": "tsc -p test/integration/tsconfig.json --noEmit",
    "deadcode": "knip",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 -T src/extension.ts src/webview/main.tsx",
    "duplication": "jscpd",
    "test": "run-s test:unit test:integration",
    "test:unit": "vitest run --coverage",
    "test:e2e:live": "vitest run test/e2e/live.e2e.test.ts",
    "test:integration": "run-s build:dev test:integration:run",
    "test:integration:run": "vscode-test",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git --redact --no-banner .",
    "quality:gates": "run-s format:check lint typecheck deadcode cycles duplication test:unit build security:audit",
    "quality": "run-s quality:gates security:secrets security:sast",
    "quality:ci": "run-s quality:gates test:integration",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "images": "node scripts/render-images.mjs",
    "prepare": "husky",
    "security:sast": "semgrep scan --config auto --error --exclude=dist --exclude=coverage --exclude=node_modules --exclude=.vscode-test"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@muse-code/sdk": "1.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.125.0",
    "@types/vscode-webview": "1.57.5",
    "@vitest/coverage-v8": "5.0.1",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "dpdm": "4.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "76.0.0",
    "husky": "9.1.7",
    "jscpd": "5.3.1",
    "jsdom": "30.1.0",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "serialize-javascript": "7.1.1",
    "diff": "8.0.3"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
