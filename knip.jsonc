    //
    // M107 (Resource governor, D87): the disk and launch refusal surface
    // ahead of governor wiring — not wired yet.
    //
    // M117 (The capacity estimator, D97): the base-risk, calibration-fit
    // and goal-snapshot surface ahead of first-estimate load — not wired yet.
    //
    // M75 (Paired efficiency evaluation, D49): the task-set splitter the
    // evaluation runner reads — not wired yet.
    //
    // M113 (Deterministic reports, D93): the local-cache and GitHub report
    // sources ahead of their /report wiring — not wired yet.
    //
    // M116 (Orchestrator playbook): the panel playbook, playbook modules,
    // playbook reports and the shared playbook rule ahead of the VS Code
    // panel integration — not wired yet.
    //
    // M71/M123 (Git and pull requests, in every editor): the GitHub
    // sign-in/token-lease surface and the pull-request checkout and panel
    // ahead of their editor wiring — not wired yet.
    //
    // M58 (Ask before every paid use): the paid-use consent surface
    // (including the schedule consent and scope) — not wired yet.
    //
    // M108 (Several accounts per provider, D88): the account policy, pool,
    // provider-client and CLI account-homes surface ahead of the panel
    // mount — not wired yet.
    //
    // M91/M91b (Hooks from every popular agent / Amp and OpenCode plugins):
    // the extension-hook fields and the plugin-hook dispatcher ahead of
    // the foreign-hooks and plugin-host bundle reads — not wired yet.
    //
    // M93 (Report a problem, D72): the webview flight record the problem
    // dialog attaches — not wired yet.
    //
    // M97 (Legal and licence scan, D76): the legal-report envelope the
    // /legal export writes — not wired yet.
    //
    // M84 (Session export and local share file, D49): the conversation
    // share preview ahead of its panel wiring — not wired yet.

    // M71's recorded GitHub REST capture (2026-09-28, `gh api -i`): the source
    // the GitHub schemas in src/core/git/github.ts and
    // src/core/reporting/sources/github.ts were written from (AGENTS.md rule
    // 14). Its tests were deleted on 2026-10-17; the recording stays.
    "test/unit/helpers/githubCapture.ts",

    // Product code whose only importers were the fake and text-only tests
    // deleted on 2026-10-17 (owner: "no more fakes at all"; chore/no-fakes).
    // Kept, never deleted for a gate: no product entry reaches these files.
    // Each waits for real-use proof (docs/real-life/unproven.md) or the
    // lead's decision to wire or remove it. Nothing else may enter this block.
    "src/core/legal/index.ts",
    "src/core/resources/trees/linuxLaunch.ts",
    "src/core/schedules/events/dependencies.ts",
    "src/core/schedules/events/network.ts",
    "src/core/schedules/events/plan.ts",
    "src/core/team/conflictPredict.ts",
    "src/core/team/mergeQueue.ts",
    "src/core/team/mergeRoutine.ts",
    "src/core/team/scheduler/retire.ts",
    "src/core/team/scheduler/reviewFlow.ts",
    "src/core/team/scheduler/stalls.ts",
    "src/core/team/teamMerge.ts",
    "src/core/team/teamWorkspaces.ts",
    "src/host/auth/metaAccountKey.ts",
    "src/host/team/gitIndexLock.ts",
    "src/host/team/landingJournal.ts",
    "src/host/team/mcpBridge.ts",
    "src/host/team/stagingCopy.ts",
    "src/host/team/teamCleanup.ts",
    "src/host/team/teamMcpServer.ts",
    "src/host/vault/brokerClient.ts",
    "src/runtime/providers/accountStore.ts",
    "src/runtime/sharing/bridge.ts",
    "src/webview/components/AttachmentSound.tsx",
    "src/webview/components/AudioAttachmentActions.tsx",
    "src/webview/developer/DeveloperOptionsPage.tsx",
    "src/webview/media/toolEntry.tsx",
    "src/webview/media/ToolVideo.tsx"
  ],

  "project": [
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "test/**/*.mjs",
    "scripts/**/*.mjs",
    "action/**/*.mjs",
    // The badge Worker (infra/marketplace-hook); wrangler deploys worker.js by path.
    "infra/**/*.js"
  ],

  "ignore": ["vendor/**"],

  // `vscode` (the extension host module) needs no entry here: knip resolves it
  // through @types/vscode. @vscode/test-electron is imported by
  // scripts/capture-themes.mjs (M37), so knip sees it. axe-core is loaded by
  // the harness page with a <script src> (test/harness/index.html, M37), which
  // knip does not read, so its use is invisible to it.
  "ignoreDependencies": ["axe-core"],

  // gitleaks (winget/brew) is a system binary, not an npm package: the
  // pre-commit hook and security:secrets call it. semgrep (pip) is started by
  // scripts/sast.mjs, which knip reads as code, not as a binary call.
  // System programs the tests start by name: mkfifo (POSIX coreutils) makes
  // the M80 stuck-output pipe and the pipe M86 refuses to open
  // (test/unit/writeRecorder.test.ts); both cases skip Windows.
  // M9 uses the installed CMake/strip toolchain for prebuilt native artifacts;
  // cc/c++ compile only the fake-engine and hostile-plugin test fixtures.
  // readelf checks the actual packaged loader search paths in real-engine tests.
  // These are system programs, not npm dependencies.
  "ignoreBinaries": ["gitleaks", "mkfifo", "cmake", "strip", "readelf", "cc", "^c\\+\\+$"],

  "ignoreExportsUsedInFile": true,

  // Planned-but-unwired product surface: an export whose JSDoc carries
  // `@unwired <milestone>` (ROADMAP.md id, e.g. `@unwired M104`) is excused
  // from the unused-exports gate, so the gate still reports any untagged
  // unused export. A built feature is never deleted to make this gate pass
  // (owner's rule, 2026-10-14).
  "tags": ["-unwired"],

  // These add-on issue types extend Knip 6's default set; listing any ordinary
  // issue type here would replace that set and silently narrow the gate.
  // Type-only namespace imports in partial mocks must not hide unused exports.
  "include": ["nsExports", "nsTypes"],

  // error = fails the run.
  //
  // `cycles` is deliberately absent: knip 6's rule reported nothing against a
  // deliberately circular pair. Cycles are gated by dpdm (`npm run cycles`).
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "binaries": "error",
    "enumMembers": "error"
  }
}
