{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code gate: unused FILES, unused EXPORTS, unused DEPENDENCIES across
  // the whole project graph. Run as a gate with plain `knip`: every rule below
  // is "error", and knip exits 1 whenever an error-level issue exists.
  //
  // Do NOT add `--strict`. Verified 2026-09-21: `--strict` implies production
  // mode, and production mode only reads `entry` patterns suffixed with `!`.
  // With this config that meant zero entry files, zero analysis, and exit 0
  // even with a planted unused export. Plain `knip` caught the same plant.
  //
  // This is .jsonc on purpose: knip 6 validates its config strictly and rejects
  // the knip 5 `"//": [...]` pseudo-comment convention.

  "entry": [
    "src/extension.ts",
    "src/host/conversation/conversationEntry.ts",
    "src/shared/validationEntry.ts",
    // Tab's lazy provider, engine and ledger (M94), loaded by path.
    "src/host/tab/tabEntry.ts",
    // The Model API backend's own bundle (M57), required by path at runtime.
    "src/host/backend/modelApiEntry.ts",
    "src/host/sessionBoardEntry.ts",
    "src/core/backends/modelapi/reviewerEntry.ts",
    "src/core/backends/modelapi/foreignHooksEntry.ts",
    // M91: the hook and MCP-form runtime, imported by path on first use.
    "src/core/backends/modelapi/hookRuntimeEntry.ts",
    // The Amp and OpenCode plugin host's own bundle (M91b), required on the first plugin hook.
    "src/core/backends/modelapi/pluginHooksEntry.ts",
    // The plan reader's own bundle (M79), required by path on the first plan action.
    "src/host/planMarkdownEntry.ts",
    // The checkpoint store's own bundle (M72), required by path at construction.
    "src/host/checkpoints/checkpointStoreEntry.ts",
    // The browser check's own bundle (M81), required by path on the first check.
    "src/host/browser/browserCheckEntry.ts",
    // Its runtime acquisition (M81 A1), required by path when a runtime is prepared.
    "src/host/browser/browserRuntimeEntry.ts",
    // The review's own bundle (M70), required by path on the first review.
    "src/host/review/reviewEntry.ts",
    // The import from other agents' own bundle (M83), required by path on the first import.
    "src/host/agentImportEntry.ts",
    "src/host/git/conversationGitEntry.ts",
    // The bundled skills installer's own bundle (M89), required by path on first use.
    "src/host/skills/bundledSkillsEntry.ts",
    // Code intelligence's `ide` answers and voice's drivers, each required by
    // path on its first use (D6, 2026-10-03).
    "src/host/ide/codeIntelEntry.ts",
    "src/host/voice/voiceEntry.ts",
    // The window's web fetch (M69), required by path on the first fetch (D6, 2026-10-04).
    "src/host/web/webFetchEntry.ts",
    // The Auto reviewer on Muse Code (M90), required on the first review.
    "src/host/review/museCodeReviewerEntry.ts",
    // Both-backend extension hooks, required by path on first use (M91 E).
    "src/host/extensionHooksEntry.ts",
    // What's New (M99), required on the first page or notice, and its page script.
    "src/host/whatsNew/whatsNewEntry.ts",
    "src/webview/whatsNew/main.ts",
    // M98's Judge, required only at the first eligible approval.
    "src/host/judge/judgeEntry.ts",
    "src/host/backend/searchWorker.ts",
    // Web fetch's page converter (M69), a worker bundle started by path.
    "src/host/web/pageWorker.ts",
    "src/webview/main.tsx",
    "src/runtime/main.ts",
    "test/unit/**/*.test.{ts,tsx,mjs}",
    "test/e2e/**/*.test.ts",
    "test/e2e/fake-muse/serve.mjs",
    // The fake stdio MCP server the M50 tests start as a child process.
    "test/unit/helpers/fakeMcpServer.mjs",
    // A bounded orphan-child process drill, launched by path at runtime.
    "test/unit/helpers/fakeMcpOrphan.mjs",
    // The Windows job drills launch these finite binary, owner-exit and
    // no-GO marker processes by path; they are real test entrypoints.
    "test/unit/helpers/fakeMcpBinary.mjs",
    "test/unit/helpers/fakeMcpLauncherParent.mjs",
    "test/unit/helpers/fakeMcpPrebindParent.mjs",
    "test/unit/helpers/fakeMcpStartMarker.mjs",
    // The never-ending monitor the M92b bounded-run proof starts by path.
    "test/fixtures/never-ending-monitor.mjs",
    "test/integration/**/*.test.ts",
    // The TypeScript fixture VS Code's language service reads in the code
    // intelligence integration test (M67); main.ts imports the rest.
    "test/fixtures/workspace/code-intel/main.ts",
    "test/hosts/*.mjs",
    // The GitHub Action's scripts (M80): each composite step runs one by path.
    "action/lib/*.mjs",
    "action/apply/lib/*.mjs",
    // The Action tests' fake agent, fake npm and Git sentinel, started by path.
    "test/action/*.mjs",
    // The fake-only test package's bin, bundled by scripts/package-acp-test.mjs (M80 W).
    "test/action/exec-test-launcher.ts",
    "scripts/**/*.mjs",
    ".vscode-test.mjs"
  ],

  "project": [
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "test/**/*.mjs",
    "scripts/**/*.mjs",
    "action/**/*.mjs"
  ],

  "ignore": ["vendor/**"],

  // `vscode` (the extension host module) needs no entry here: knip resolves it
  // through @types/vscode. @vscode/test-electron is imported by
  // scripts/capture-themes.mjs (M37), so knip sees it. axe-core is loaded by
  // the harness page with a <script src> (test/harness/index.html, M37), which
  // knip does not read, so its use is invisible to it.
  "ignoreDependencies": ["axe-core"],

  // gitleaks (winget/brew) is a system binary, not an npm package: the
  // pre-commit hook and security:secrets call it. semgrep (pip) is started by
  // scripts/sast.mjs, which knip reads as code, not as a binary call.
  // System programs the tests start by name: mkfifo (POSIX coreutils) makes
  // the M80 stuck-output pipe and the pipe M86 refuses to open
  // (test/unit/writeRecorder.test.ts); both cases skip Windows.
  "ignoreBinaries": ["gitleaks", "mkfifo"],

  "ignoreExportsUsedInFile": true,

  // These add-on issue types extend Knip 6's default set; listing any ordinary
  // issue type here would replace that set and silently narrow the gate.
  // Type-only namespace imports in partial mocks must not hide unused exports.
  "include": ["nsExports", "nsTypes"],

  // error = fails the run.
  //
  // `cycles` is deliberately absent: knip 6's rule reported nothing against a
  // deliberately circular pair. Cycles are gated by dpdm (`npm run cycles`).
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "binaries": "error",
    "enumMembers": "error"
  }
}
