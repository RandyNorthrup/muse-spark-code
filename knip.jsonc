{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code gate: unused FILES, unused EXPORTS, unused DEPENDENCIES across
  // the whole project graph. Run as a gate with plain `knip`: every rule below
  // is "error", and knip exits 1 whenever an error-level issue exists.
  //
  // Do NOT add `--strict`. Verified 2026-09-21: `--strict` implies production
  // mode, and production mode only reads `entry` patterns suffixed with `!`.
  // With this config that meant zero entry files, zero analysis, and exit 0
  // even with a planted unused export. Plain `knip` caught the same plant.
  //
  // This is .jsonc on purpose: knip 6 validates its config strictly and rejects
  // the knip 5 `"//": [...]` pseudo-comment convention.

  "entry": [
    "src/extension.ts",
    "src/host/backend/searchWorker.ts",
    "src/webview/main.tsx",
    "src/runtime/main.ts",
    "test/unit/**/*.test.{ts,tsx}",
    "test/e2e/**/*.test.ts",
    "test/e2e/fake-muse/serve.mjs",
    "test/integration/**/*.test.ts",
    "test/hosts/*.mjs",
    "scripts/**/*.mjs",
    ".vscode-test.mjs"
  ],

  "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "test/**/*.mjs", "scripts/**/*.mjs"],

  // `vscode` (the extension host module) needs no entry here: knip resolves it
  // through @types/vscode. @vscode/test-electron is imported by
  // scripts/capture-themes.mjs (M37), so knip sees it. axe-core is loaded by
  // the harness page with a <script src> (test/harness/index.html, M37), which
  // knip does not read, so its use is invisible to it.
  "ignoreDependencies": ["axe-core"],

  // gitleaks (winget/brew) is a system binary, not an npm package: the
  // pre-commit hook and security:secrets call it. semgrep (pip) is started by
  // scripts/sast.mjs, which knip reads as code, not as a binary call.
  "ignoreBinaries": ["gitleaks"],

  "ignoreExportsUsedInFile": true,

  // error = fails the run.
  //
  // `cycles` is deliberately absent: knip 6's rule reported nothing against a
  // deliberately circular pair. Cycles are gated by dpdm (`npm run cycles`).
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error",
    "binaries": "error",
    "enumMembers": "error"
  }
}
