{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out StopFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out SessionEnd",
            "timeout": 30
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out Interrupt",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionFork": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <scratch>/hook.cjs <scratch>/out SessionFork",
            "timeout": 2,
            "async": false
          }
        ]
      }
    ]
  }
}
