{
  "contributes": {
    "commands": [
      {
        "command": "museSpark.shareChat",
        "title": "%command.shareChat.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.sharePrompt",
        "title": "%command.sharePrompt.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.promptLibrary",
        "title": "%command.promptLibrary.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.savePrompt",
        "title": "%command.savePrompt.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.useSavedPrompt",
        "title": "%command.useSavedPrompt.title%",
        "category": "%command.category%"
      },
      {
        "command": "museSpark.copyToMyPrompts",
        "title": "%command.copyToMyPrompts.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "editor/context": [
        { "command": "museSpark.savePrompt", "when": "editorHasSelection", "group": "museSpark@1" }
      ],
      "webview/context": [
        {
          "command": "museSpark.savePrompt",
          "when": "(webviewId == 'museSpark.chatPanel' || webviewId == 'museSpark.chatView') && museSpark.transcriptRole == user && museSpark.messageIsOwn",
          "group": "museSpark@1"
        },
        {
          "command": "museSpark.savePrompt",
          "when": "(webviewId == 'museSpark.chatPanel' || webviewId == 'museSpark.chatView') && museSpark.composerHasText",
          "group": "museSpark@1"
        },
        {
          "command": "museSpark.useSavedPrompt",
          "when": "(webviewId == 'museSpark.chatPanel' || webviewId == 'museSpark.chatView') && museSpark.chatAvailable",
          "group": "museSpark@2"
        }
      ]
    }
  }
}
