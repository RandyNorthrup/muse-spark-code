{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?![0-9.]+$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        }
      ]
    },
    "repository": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?!\\/)(?!.*[\\\\\\x00-\\x1f\\x7f])(?!(?:.*\\/)?\\.\\.?(?:\\/|$))[^/]+(?:\\/[^/]+)*$"
    },
    "hostKeyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": ["host", "port", "user", "repository", "hostKeyDigest"],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/RandyNorthrup/muse-spark-code/main/docs/schemas/node-git-destination-v1.schema.json",
  "x-node-runtime-validation": "Parse with the canonical src/shared/node.ts or nodeAuth.ts schema: private addresses, ownership, time ordering, unique IDs, attendance, UTF8 byte caps, nonempty executable and NUL-free arguments require runtime checks. Digest, hash-chain, session expiry and cryptographic proof verification require their runtime bindings."
}
