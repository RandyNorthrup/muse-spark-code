{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "const": "home"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\p{Cc}]+$"
    },
    "browserNames": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?=.{1,253}$)(?![0-9.]+$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
      }
    },
    "listener": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "ipv4",
                  "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
                },
                {
                  "type": "string",
                  "format": "ipv6",
                  "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
                }
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["address", "port"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\/(?!\\.{1,2}(?:\\/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[^\\p{Cc}\\\\]+$"
    },
    "audit": {
      "type": "object",
      "properties": {
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10485760
        },
        "retentionDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      },
      "required": ["maxBytes", "retentionDays"],
      "additionalProperties": false
    }
  },
  "required": ["v", "mode", "label", "browserNames", "listener", "workspaceRoot", "audit"],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/RandyNorthrup/muse-spark-code/main/docs/schemas/node-config-v1.schema.json",
  "x-node-runtime-validation": "Parse with the canonical src/shared/node.ts or nodeAuth.ts schema: private addresses, ownership, time ordering, unique IDs, attendance, UTF8 byte caps, nonempty executable and NUL-free arguments require runtime checks. Digest, hash-chain, session expiry and cryptographic proof verification require their runtime bindings."
}
