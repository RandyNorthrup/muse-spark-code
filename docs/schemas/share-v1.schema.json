{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "title": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "scrubbed": { "type": "boolean", "const": true },
        "mode": { "type": "string", "enum": ["full", "conversation"] },
        "options": {
          "type": "object",
          "properties": {
            "codeBlocks": { "default": true, "type": "boolean" },
            "attachmentNames": { "default": true, "type": "boolean" },
            "diffs": { "default": false, "type": "boolean" },
            "attachmentContents": {
              "default": [],
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["codeBlocks", "attachmentNames", "diffs", "attachmentContents"],
          "additionalProperties": false
        },
        "target": { "type": "string", "const": "chat" },
        "range": {
          "type": "object",
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          },
          "required": ["from", "to"],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "text": { "type": "string" },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "name": { "type": "string" },
                    "content": { "type": "string" }
                  },
                  "required": ["id"],
                  "additionalProperties": false
                }
              },
              "tool": { "type": "string" },
              "args": { "type": "string" },
              "output": { "type": "string" },
              "command": { "type": "string" },
              "decision": { "type": "string" },
              "diff": { "type": "string" },
              "reasoning": { "type": "string" }
            },
            "required": ["id", "kind"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "title",
        "createdAt",
        "scrubbed",
        "mode",
        "options",
        "target",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "title": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "scrubbed": { "type": "boolean", "const": true },
        "mode": { "type": "string", "enum": ["full", "conversation"] },
        "options": {
          "type": "object",
          "properties": {
            "codeBlocks": { "default": true, "type": "boolean" },
            "attachmentNames": { "default": true, "type": "boolean" },
            "diffs": { "default": false, "type": "boolean" },
            "attachmentContents": {
              "default": [],
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["codeBlocks", "attachmentNames", "diffs", "attachmentContents"],
          "additionalProperties": false
        },
        "target": { "type": "string", "const": "prompt" },
        "prompt": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "number", "const": 1 },
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z_][\\w-]*$" },
                  "source": {
                    "type": "string",
                    "enum": ["selection", "file", "clipboard", "input"]
                  }
                },
                "required": ["name", "source"],
                "additionalProperties": false
              }
            },
            "scope": { "type": "string", "enum": ["user", "workspace"] },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "untrusted": { "type": "boolean" },
            "body": { "type": "string" }
          },
          "required": [
            "schemaVersion",
            "id",
            "title",
            "tags",
            "variables",
            "scope",
            "createdAt",
            "updatedAt",
            "untrusted",
            "body"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "title",
        "createdAt",
        "scrubbed",
        "mode",
        "options",
        "target",
        "prompt"
      ],
      "additionalProperties": false
    }
  ],
  "x-runtime-invariants": [
    "Conversation mode admits only userMessage and agentMessage, and no activity fields within messages; unknown kinds are excluded.",
    "Code blocks obey options.codeBlocks; attachment names obey options.attachmentNames; contents require their id in options.attachmentContents; diffs require options.diffs.",
    "Every string is scrubbed with registered-secret and shared redaction plus workspace/home/absolute-path normalisation before preview.",
    "No destination is invoked before exact-preview confirmation and a fresh non-confidential-workspace check; phase one allows copy/file/browser only.",
    "Prompt variables exactly match unique placeholders; createdAt <= updatedAt; imported prompts remain untrusted and never auto-run."
  ]
}
