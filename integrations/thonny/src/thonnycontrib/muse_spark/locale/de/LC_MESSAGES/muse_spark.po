msgid ""
msgstr "Language: de\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "Open Muse Spark"
msgstr "Muse Spark öffnen"

msgid "Stop machine"
msgstr "Maschine stoppen"

msgid "Stop"
msgstr "Anhalten"

msgid "Cannot start Muse Spark"
msgstr "Muse Spark kann nicht gestartet werden"

msgid "Cannot reach Muse Spark"
msgstr "Muse Spark ist nicht erreichbar"

msgid "Cannot open Muse Spark"
msgstr "Muse Spark kann nicht geöffnet werden"

msgid "Stop machine failed"
msgstr "Maschine konnte nicht gestoppt werden"

msgid "The runtime could not start. Check its installation and try again."
msgstr "Die Laufzeit konnte nicht gestartet werden. Prüfen Sie die Installation und versuchen Sie es erneut."

msgid "The local provider connection failed. Close Muse Spark and try again."
msgstr "Die Verbindung zum lokalen Anbieter ist fehlgeschlagen. Schließen Sie Muse Spark und versuchen Sie es erneut."

msgid "The system browser could not open the companion page."
msgstr "Der Systembrowser konnte die Begleitseite nicht öffnen."

msgid "The stop command failed. Use the machine's physical emergency stop if needed."
msgstr "Der Stoppbefehl ist fehlgeschlagen. Betätigen Sie bei Bedarf den physischen Not-Aus der Maschine."

msgid "Hand the port to Muse Spark"
msgstr "Port an Muse Spark übergeben"

msgid "Give the port back to Thonny"
msgstr "Port an Thonny zurückgeben"

msgid "Cannot transfer the port"
msgstr "Port kann nicht übergeben werden"

msgid "Port ownership was not confirmed. Select an explicit serial port, open Muse Spark, and try again. Thonny stays disconnected after an uncertain transfer."
msgstr "Die Portübernahme wurde nicht bestätigt. Wählen Sie einen konkreten seriellen Port, öffnen Sie Muse Spark und versuchen Sie es erneut. Nach einer ungewissen Übergabe bleibt Thonny getrennt."
