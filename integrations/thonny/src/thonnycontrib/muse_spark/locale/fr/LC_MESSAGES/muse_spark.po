msgid "Open Muse Spark"
msgstr "Ouvrir Muse Spark"

msgid "Stop machine"
msgstr "Arrêter la machine"

msgid "Stop"
msgstr "Arrêter"

msgid "Cannot start Muse Spark"
msgstr "Impossible de démarrer Muse Spark"

msgid "Cannot reach Muse Spark"
msgstr "Impossible de joindre Muse Spark"

msgid "Cannot open Muse Spark"
msgstr "Impossible d’ouvrir Muse Spark"

msgid "Stop machine failed"
msgstr "Échec de l’arrêt de la machine"

msgid "The runtime could not start. Check its installation and try again."
msgstr "L’environnement d’exécution n’a pas pu démarrer. Vérifiez son installation et réessayez."

msgid "The local provider connection failed. Close Muse Spark and try again."
msgstr "La connexion au fournisseur local a échoué. Fermez Muse Spark et réessayez."

msgid "The system browser could not open the companion page."
msgstr "Le navigateur du système n’a pas pu ouvrir la page compagnon."

msgid "The stop command failed. Use the machine's physical emergency stop if needed."
msgstr "La commande d’arrêt a échoué. Si nécessaire, utilisez l’arrêt d’urgence physique de la machine."
