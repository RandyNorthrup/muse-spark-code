<idea-plugin>
  <id>io.github.randynorthrup.musespark</id>
  <name>Muse Spark Code (Unofficial)</name>
  <vendor url="https://github.com/RandyNorthrup/muse-spark-code">RandyNorthrup</vendor>
  <description>A shared Muse Spark Code panel for IntelliJ-based editors. Unofficial; not endorsed by Meta.</description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider implementation="io.github.randynorthrup.musespark.PanelFileEditorProvider" />
    <notificationGroup id="Muse Spark Code (Unofficial)" displayType="BALLOON"/>
    <toolWindow id="Muse Spark Code (Unofficial)" anchor="right"
                factoryClass="io.github.randynorthrup.musespark.MuseToolWindowFactory"/>
  </extensions>
</idea-plugin>
